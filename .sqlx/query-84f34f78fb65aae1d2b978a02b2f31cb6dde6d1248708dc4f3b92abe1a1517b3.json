{
  "db_name": "PostgreSQL",
  "query": "\n                    SELECT nonce, state as \"state: NonceState\"\n                    FROM nonce.nonce_assignments\n                    WHERE execution_id = $1\n                        AND state IN ('reserved', 'finalized')\n                    ORDER BY revision DESC\n                    LIMIT 1\n                    ",
