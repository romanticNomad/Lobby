# Custody keys
export LOBBY_TEST_KEYS="benchmark/test_keys.json"

# Database -> set dynamically by the test-containers, injected via tokio::process.

# Server
export SERVER_ADDR="0.0.0.0:3000"

# Logging
export RUST_LOG="INFO"

# shards and semaphore settings

## sharded by execution_id
export RELAYHOST_SHARDS=1000
export SIGN_SHARDS=1000
export BROADCAST_SHARDS=1000
export VALIDATOR_SHARDS=1000

## sharded by from_address
export NONCE_SHARDS=1000

## channel_buffer and semaphore limits
export PIPELINE_CONCURRENCY=50000
export ACTOR_BUFFER_SIZE=10000
